<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- To see console output during development, change to Exe or set DOTNET_CONSOLE_ANSI_COLOR=1 -->
    <!-- In Debug builds we attach a console window via AllocConsole (see App.xaml.cs) -->
    <!-- Windows 10 1903+ required for Windows.Media.Ocr and Windows.Graphics.Capture -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms for System.Windows.Forms.Screen monitor enumeration -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- PerMonitorV2 DPI awareness (replaces legacy manifest entries; avoids WFAC010) -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>JPLens</RootNamespace>
    <AssemblyName>JPLens</AssemblyName>
    <StartupObject>JPLens.App</StartupObject>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>JPLens.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Dependency injection & logging -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />

    <!-- Structured logging via Serilog -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="2.0.0" />

    <!-- System tray icon (WPF) -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />

    <!-- GDI+ image manipulation (screen capture, preprocessing) -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />

    <!-- MeCab morphological analysis (bundles IPAdic dictionary) -->
    <PackageReference Include="MeCab.DotNet" Version="1.2.0" />

    <!-- PaddleOCR ONNX inference -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.17.3" />
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
  </ItemGroup>

  <!-- PaddleOCR model files: place det_model.onnx, rec_model.onnx, cls_model.onnx,
       and japan_dict.txt in JPLens.App\models\paddle\ then rebuild. -->
  <ItemGroup>
    <Content Include="models\paddle\**" CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('models\paddle')" />
  </ItemGroup>

  <!-- MeCab dictionary files: the NuGet package's targets declare them as Content
       with CopyToOutputDirectory, but with PublishSingleFile=true the SDK treats
       .bin files as native binaries and bundles them into the EXE instead of placing
       them next to it.  Use Update to override that behaviour for all dic files. -->
  <ItemGroup>
    <Content Update="$(MeCabPackageDefaultContentPath)\dic\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
